          "default": null,
          "title": "Id"
        },
        "kind": {
          "default": "image",
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "default": "local",
          "enum": [
            "local",
            "user",
            "licensed_stock",
            "generated",
            "screenshot",
            "recording",
            "remote"
          ],
          "title": "Origin",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
