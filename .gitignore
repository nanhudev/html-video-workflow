__pycache__/
*.py[cod]
.venv/
build/
outputs/
*.mp4
*.wav
.env

# Demo media is documentation, not build output — the README links to it, so it
# has to be in the repository or the link is a 404.
!docs/assets/demo.mp4

# Node / Studio frontend dependencies and build output.
node_modules/
dist/
# The built frontend, vendored into the package by the release build. Generated,
# never committed — a checkout builds it with `npm run build`.
src/html_video_workflow/studio_dist/

# Editable-install metadata. Written next to the source by `pip install -e`,
# not part of the project.
*.egg-info/
*.tsbuildinfo
vite.config.ts.timestamp-*

# Output of the end-to-end checks. Written next to the repository by
# `scripts/e2e_one_click.py` so a red build can be read without logs; they are
# run artefacts, not source.
cli-result-*.json
cli-stderr-*.txt
e2e-out*/

# Python test tooling caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local run/application home (created by HVW_HOME).
.hvw-home/

# WorkBuddy agent memory for this project — not project source.
.workbuddy/
